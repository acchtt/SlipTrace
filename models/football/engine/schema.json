{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "football-engine-v1",
  "title": "SlipTrace Football Engine Input",
  "description": "Structured bridge between LLM football research and deterministic Football C/C2 rules.",
  "oneOf": [
    {
      "$ref": "#/$defs/boardInput"
    },
    {
      "$ref": "#/$defs/decisionInput"
    }
  ],
  "$defs": {
    "route": {
      "type": "string",
      "enum": [
        "WEAK",
        "USABLE",
        "STRONG"
      ]
    },
    "carrier": {
      "type": "string",
      "enum": [
        "NONE",
        "USABLE",
        "STRONG"
      ]
    },
    "grade": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "boardState": {
      "type": "string",
      "enum": [
        "PASS",
        "WATCH",
        "FOCUS",
        "C-PASS",
        "C-WATCH",
        "C-FOCUS",
        "C2-PASS",
        "C2-WATCH",
        "C2-FOCUS"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "match_id",
        "home_route",
        "away_route",
        "carrier",
        "route_reliability",
        "independent_route_quality",
        "chance_quality",
        "failure_resistance",
        "xi_robustness",
        "evidence_confidence",
        "burden_protection",
        "supported_line",
        "tournament_incentive_required",
        "tournament_format_status",
        "competition_stage",
        "competition_format",
        "draw_resolution",
        "aggregate_state",
        "home_incentive",
        "away_incentive",
        "tiebreak_margin_relevance",
        "incentive_effect"
      ],
      "properties": {
        "match_id": {
          "type": "string",
          "minLength": 1
        },
        "home_route": {
          "$ref": "#/$defs/route"
        },
        "away_route": {
          "$ref": "#/$defs/route"
        },
        "carrier": {
          "$ref": "#/$defs/carrier"
        },
        "route_reliability": {
          "$ref": "#/$defs/grade"
        },
        "independent_route_quality": {
          "$ref": "#/$defs/grade"
        },
        "chance_quality": {
          "$ref": "#/$defs/grade"
        },
        "failure_resistance": {
          "$ref": "#/$defs/grade"
        },
        "xi_robustness": {
          "$ref": "#/$defs/grade"
        },
        "evidence_confidence": {
          "$ref": "#/$defs/grade"
        },
        "burden_protection": {
          "$ref": "#/$defs/grade"
        },
        "supported_line": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.25
        },
        "carrier_self_fund": {
          "type": "boolean",
          "default": false
        },
        "independent_upper_tail": {
          "type": "boolean",
          "default": false
        },
        "failure_attacks_route": {
          "type": "boolean",
          "default": false
        },
        "material_suppression": {
          "type": "boolean",
          "default": false
        },
        "board_state": {
          "$ref": "#/$defs/boardState"
        },
        "main_failure": {
          "type": "string"
        },
        "h2h_state": {
          "type": "string"
        },
        "evidence_note": {
          "type": "string"
        },
        "tournament_incentive_required": {
          "type": "boolean"
        },
        "tournament_format_status": {
          "$ref": "#/$defs/formatStatus"
        },
        "competition_stage": {
          "type": "string",
          "minLength": 1
        },
        "competition_format": {
          "type": "string",
          "minLength": 1
        },
        "draw_resolution": {
          "type": "string",
          "minLength": 1
        },
        "aggregate_state": {
          "type": "string",
          "minLength": 1
        },
        "home_incentive": {
          "$ref": "#/$defs/incentiveState"
        },
        "away_incentive": {
          "$ref": "#/$defs/incentiveState"
        },
        "tiebreak_margin_relevance": {
          "$ref": "#/$defs/yesNoUnknown"
        },
        "incentive_effect": {
          "$ref": "#/$defs/incentiveEffect"
        }
      }
    },
    "boardInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "stage",
        "model",
        "matches"
      ],
      "properties": {
        "schema_version": {
          "const": "football-engine-v1"
        },
        "stage": {
          "const": "board"
        },
        "model": {
          "enum": [
            "c",
            "c2"
          ]
        },
        "matches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assessment"
          }
        }
      }
    },
    "decisionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "stage",
        "model",
        "match",
        "context"
      ],
      "properties": {
        "schema_version": {
          "const": "football-engine-v1"
        },
        "stage": {
          "const": "decision"
        },
        "model": {
          "enum": [
            "c",
            "c2"
          ]
        },
        "match": {
          "$ref": "#/$defs/assessment"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "board_state",
            "thesis_state",
            "quote",
            "tournament_incentive_rechecked"
          ],
          "properties": {
            "board_state": {
              "$ref": "#/$defs/boardState"
            },
            "thesis_state": {
              "enum": [
                "PRESERVED",
                "DEGRADED",
                "BROKEN"
              ]
            },
            "quote": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "line",
                "odds"
              ],
              "properties": {
                "line": {
                  "type": "number",
                  "minimum": 0,
                  "multipleOf": 0.25
                },
                "odds": {
                  "type": "number",
                  "exclusiveMinimum": 1
                }
              }
            },
            "top_ranked_focus": {
              "type": "boolean",
              "default": false
            },
            "primary_mechanism_intact": {
              "type": "boolean",
              "default": true
            },
            "wait_reachable": {
              "type": "boolean",
              "default": false
            },
            "wait_requires_negative_info": {
              "type": "boolean",
              "default": false
            },
            "material_veto": {
              "type": "boolean",
              "default": false
            },
            "tournament_incentive_rechecked": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "formatStatus": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "VERIFIED",
        "LIMITED",
        "UNKNOWN"
      ]
    },
    "incentiveState": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "MUST_WIN",
        "WIN_PREFERRED",
        "DRAW_ACCEPTABLE",
        "MARGIN_NEEDED",
        "PROTECT_AGGREGATE",
        "PROTECT_RESULT",
        "DEAD_RUBBER",
        "PLACEMENT_ONLY",
        "UNKNOWN"
      ]
    },
    "incentiveEffect": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "EXPANSIVE",
        "NEUTRAL",
        "SUPPRESSIVE",
        "MIXED",
        "UNKNOWN"
      ]
    },
    "yesNoUnknown": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "YES",
        "NO",
        "UNKNOWN"
      ]
    }
  }
}
