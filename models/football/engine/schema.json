{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "football-engine-v1",
  "title": "SlipTrace Football Engine Input",
  "description": "Structured bridge between LLM football research and deterministic Football C/C2 rules.",
  "oneOf": [
    {
      "$ref": "#/$defs/boardInput"
    },
    {
      "$ref": "#/$defs/decisionInput"
    },
    {
      "$ref": "#/$defs/auditInput"
    }
  ],
  "$defs": {
    "route": {
      "type": "string",
      "enum": [
        "WEAK",
        "USABLE",
        "STRONG"
      ]
    },
    "carrier": {
      "type": "string",
      "enum": [
        "NONE",
        "USABLE",
        "STRONG"
      ]
    },
    "grade": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "boardState": {
      "type": "string",
      "enum": [
        "PASS",
        "WATCH",
        "FOCUS",
        "C-PASS",
        "C-WATCH",
        "C-FOCUS",
        "C2-PASS",
        "C2-WATCH",
        "C2-FOCUS"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "match_id",
        "demoted_probation",
        "competition_reliability_manual_override",
        "competition_reliability_reason",
        "competition_reliability_state",
        "raw_operational_viability_grade",
        "operational_viability_reason",
        "team_news_observability",
        "market_observability",
        "xi_expected",
        "operational_viability_grade",
        "home_route",
        "away_route",
        "carrier",
        "route_reliability",
        "independent_route_quality",
        "chance_quality",
        "failure_resistance",
        "xi_robustness",
        "evidence_confidence",
        "burden_protection",
        "supported_line",
        "tournament_incentive_required",
        "tournament_format_status",
        "competition_stage",
        "competition_format",
        "draw_resolution",
        "aggregate_state",
        "home_incentive",
        "away_incentive",
        "tiebreak_margin_relevance",
        "incentive_effect",
        "qualification_state",
        "simultaneous_results_status",
        "simultaneous_results_note",
        "kickoff_ict",
        "completion_mode",
        "burden_completion_quality",
        "continuation_quality",
        "opponent_leakage",
        "burden_stall_risk",
        "main_failure",
        "h2h_state",
        "carrier_self_fund",
        "independent_upper_tail",
        "failure_attacks_route",
        "material_suppression"
      ],
      "properties": {
        "match_id": {
          "type": "string",
          "minLength": 1
        },
        "home_route": {
          "$ref": "#/$defs/route"
        },
        "away_route": {
          "$ref": "#/$defs/route"
        },
        "carrier": {
          "$ref": "#/$defs/carrier"
        },
        "route_reliability": {
          "$ref": "#/$defs/grade"
        },
        "independent_route_quality": {
          "$ref": "#/$defs/grade"
        },
        "chance_quality": {
          "$ref": "#/$defs/grade"
        },
        "failure_resistance": {
          "$ref": "#/$defs/grade"
        },
        "xi_robustness": {
          "$ref": "#/$defs/grade"
        },
        "evidence_confidence": {
          "$ref": "#/$defs/grade"
        },
        "burden_protection": {
          "$ref": "#/$defs/grade"
        },
        "supported_line": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.25
        },
        "carrier_self_fund": {
          "type": "boolean",
          "default": false
        },
        "independent_upper_tail": {
          "type": "boolean",
          "default": false
        },
        "failure_attacks_route": {
          "type": "boolean",
          "default": false
        },
        "material_suppression": {
          "type": "boolean",
          "default": false
        },
        "board_state": {
          "$ref": "#/$defs/boardState"
        },
        "main_failure": {
          "type": "string",
          "minLength": 1
        },
        "h2h_state": {
          "type": "string",
          "minLength": 1
        },
        "evidence_note": {
          "type": "string"
        },
        "tournament_incentive_required": {
          "type": "boolean"
        },
        "tournament_format_status": {
          "$ref": "#/$defs/formatStatus"
        },
        "competition_stage": {
          "type": "string",
          "minLength": 1
        },
        "competition_format": {
          "type": "string",
          "minLength": 1
        },
        "draw_resolution": {
          "type": "string",
          "minLength": 1
        },
        "aggregate_state": {
          "type": "string",
          "minLength": 1
        },
        "home_incentive": {
          "$ref": "#/$defs/incentiveState"
        },
        "away_incentive": {
          "$ref": "#/$defs/incentiveState"
        },
        "tiebreak_margin_relevance": {
          "$ref": "#/$defs/yesNoUnknown"
        },
        "incentive_effect": {
          "$ref": "#/$defs/incentiveEffect"
        },
        "qualification_state": {
          "type": "string",
          "minLength": 1
        },
        "simultaneous_results_status": {
          "type": "string",
          "enum": [
            "NOT_APPLICABLE",
            "VERIFIED",
            "LIMITED",
            "UNKNOWN"
          ]
        },
        "simultaneous_results_note": {
          "type": "string",
          "minLength": 1
        },
        "operational_viability_grade": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "xi_expected": {
          "type": "string",
          "enum": [
            "YES",
            "UNCERTAIN",
            "NO"
          ]
        },
        "market_observability": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "NONE"
          ]
        },
        "team_news_observability": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "NONE"
          ]
        },
        "operational_viability_reason": {
          "type": "string",
          "minLength": 1
        },
        "raw_operational_viability_grade": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "competition_reliability_state": {
          "type": "string",
          "enum": [
            "UNPROVEN",
            "TRUSTED",
            "NEUTRAL",
            "CAUTION",
            "DEMOTED"
          ]
        },
        "competition_reliability_reason": {
          "type": "string",
          "minLength": 1
        },
        "competition_reliability_manual_override": {
          "type": "string",
          "enum": [
            "NONE",
            "TRUSTED",
            "NEUTRAL",
            "CAUTION",
            "DEMOTED"
          ]
        },
        "demoted_probation": {
          "type": "boolean"
        },
        "kickoff_ict": {
          "type": "string",
          "minLength": 1
        },
        "completion_mode": {
          "type": "string",
          "enum": [
            "NONE",
            "TWO_SIDED",
            "CARRIER_LED",
            "FORCED_CHAOS",
            "MIXED"
          ]
        },
        "burden_completion_quality": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "continuation_quality": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "opponent_leakage": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "burden_stall_risk": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        }
      }
    },
    "boardInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "stage",
        "model",
        "matches"
      ],
      "properties": {
        "schema_version": {
          "const": "football-engine-v1"
        },
        "stage": {
          "const": "board"
        },
        "model": {
          "enum": [
            "c",
            "c2"
          ]
        },
        "matches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assessment"
          }
        }
      }
    },
    "decisionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "stage",
        "model",
        "match",
        "context"
      ],
      "properties": {
        "schema_version": {
          "const": "football-engine-v1"
        },
        "stage": {
          "const": "decision"
        },
        "model": {
          "enum": [
            "c",
            "c2"
          ]
        },
        "match": {
          "$ref": "#/$defs/assessment"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "board_state",
            "thesis_state",
            "quote",
            "tournament_incentive_rechecked",
            "tournament_incentive_recheck_status",
            "xi_status",
            "post_xi_research_status",
            "h2h_review_status",
            "h2h_rechecked",
            "completion_rechecked",
            "top_ranked_focus",
            "primary_mechanism_intact",
            "wait_reachable",
            "wait_requires_negative_info",
            "material_veto"
          ],
          "properties": {
            "board_state": {
              "$ref": "#/$defs/boardState"
            },
            "thesis_state": {
              "enum": [
                "PRESERVED",
                "DEGRADED",
                "BROKEN"
              ]
            },
            "quote": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "line",
                "odds"
              ],
              "properties": {
                "line": {
                  "type": "number",
                  "minimum": 0,
                  "multipleOf": 0.25
                },
                "odds": {
                  "type": "number",
                  "exclusiveMinimum": 1
                }
              }
            },
            "top_ranked_focus": {
              "type": "boolean",
              "default": false
            },
            "primary_mechanism_intact": {
              "type": "boolean",
              "default": true
            },
            "wait_reachable": {
              "type": "boolean",
              "default": false
            },
            "wait_requires_negative_info": {
              "type": "boolean",
              "default": false
            },
            "material_veto": {
              "type": "boolean",
              "default": false
            },
            "tournament_incentive_rechecked": {
              "type": "boolean"
            },
            "tournament_incentive_recheck_status": {
              "type": "string",
              "enum": [
                "NOT_APPLICABLE",
                "VERIFIED",
                "LIMITED",
                "UNKNOWN"
              ]
            },
            "xi_status": {
              "type": "string",
              "enum": [
                "CONFIRMED",
                "RELIABLE",
                "UNAVAILABLE"
              ]
            },
            "post_xi_research_status": {
              "type": "string",
              "enum": [
                "FOUND",
                "LIMITED",
                "UNAVAILABLE_ATTEMPTED"
              ]
            },
            "h2h_review_status": {
              "type": "string",
              "enum": [
                "REVIEWED_USABLE",
                "REVIEWED_LIMITED",
                "NOT_USABLE",
                "UNAVAILABLE"
              ]
            },
            "h2h_rechecked": {
              "type": "boolean"
            },
            "completion_rechecked": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "formatStatus": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "VERIFIED",
        "LIMITED",
        "UNKNOWN"
      ]
    },
    "incentiveState": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "MUST_WIN",
        "WIN_PREFERRED",
        "DRAW_ACCEPTABLE",
        "MARGIN_NEEDED",
        "PROTECT_AGGREGATE",
        "PROTECT_RESULT",
        "DEAD_RUBBER",
        "PLACEMENT_ONLY",
        "UNKNOWN"
      ]
    },
    "incentiveEffect": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "EXPANSIVE",
        "NEUTRAL",
        "SUPPRESSIVE",
        "MIXED",
        "UNKNOWN"
      ]
    },
    "yesNoUnknown": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "YES",
        "NO",
        "UNKNOWN"
      ]
    },
    "auditInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "stage",
        "match_id",
        "model_version",
        "frozen",
        "observed",
        "diagnosis",
        "pnl_status"
      ],
      "properties": {
        "schema_version": {
          "const": "football-engine-v1"
        },
        "stage": {
          "const": "audit_record"
        },
        "match_id": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "frozen": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "c_board_state",
            "follow_lane",
            "supported_line",
            "completion_mode",
            "burden_completion_quality",
            "continuation_quality",
            "opponent_leakage",
            "burden_stall_risk",
            "c_action",
            "quote_line",
            "quote_odds"
          ],
          "properties": {
            "c_board_state": {
              "type": "string",
              "enum": [
                "C-PASS",
                "C-WATCH",
                "C-FOCUS",
                "NONE"
              ]
            },
            "follow_lane": {
              "type": "string",
              "enum": [
                "FOLLOW",
                "RESERVE",
                "STOP",
                "NONE"
              ]
            },
            "supported_line": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "multipleOf": 0.25
            },
            "completion_mode": {
              "type": "string",
              "enum": [
                "NONE",
                "TWO_SIDED",
                "CARRIER_LED",
                "FORCED_CHAOS",
                "MIXED"
              ]
            },
            "burden_completion_quality": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            },
            "continuation_quality": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            },
            "opponent_leakage": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            },
            "burden_stall_risk": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            },
            "c_action": {
              "type": "string",
              "enum": [
                "C-BET",
                "C-WAIT",
                "C-PASS",
                "NONE"
              ]
            },
            "quote_line": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "multipleOf": 0.25
            },
            "quote_odds": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 1
            }
          }
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ht_score",
            "ft_score",
            "settlement",
            "completion_materialized",
            "continuation_materialized",
            "carrier_self_fund_materialized",
            "opponent_route_materialized"
          ],
          "properties": {
            "ht_score": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "ft_score": {
              "type": "string",
              "minLength": 1
            },
            "settlement": {
              "type": "string",
              "enum": [
                "WIN",
                "HALF_WIN",
                "PUSH",
                "HALF_LOSS",
                "LOSS",
                "NO_OFFICIAL_EXPOSURE",
                "NOT_APPLICABLE"
              ]
            },
            "completion_materialized": {
              "type": "string",
              "enum": [
                "YES",
                "NO",
                "UNKNOWN"
              ]
            },
            "continuation_materialized": {
              "type": "string",
              "enum": [
                "YES",
                "NO",
                "UNKNOWN"
              ]
            },
            "carrier_self_fund_materialized": {
              "type": "string",
              "enum": [
                "YES",
                "NO",
                "UNKNOWN",
                "NOT_APPLICABLE"
              ]
            },
            "opponent_route_materialized": {
              "type": "string",
              "enum": [
                "YES",
                "NO",
                "UNKNOWN",
                "NOT_APPLICABLE"
              ]
            }
          }
        },
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tags",
            "pre_freeze_evidence_miss",
            "pre_freeze_evidence_note",
            "retrospective_hypothesis_only"
          ],
          "properties": {
            "tags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "MODEL_FALSE_POSITIVE",
                  "MODEL_FALSE_NEGATIVE",
                  "FOLLOW_PRIORITY_MISS",
                  "PROCESS_MISS",
                  "EXECUTION_MISS",
                  "OPERATIONAL_OPPORTUNITY_COST",
                  "NO_OFFICIAL_EXPOSURE",
                  "NO_RETROSPECTIVE_MODEL_CHANGE",
                  "TOURNAMENT_INCENTIVE_MISS",
                  "FORMAT_DATA_MISSING",
                  "STALE_INCENTIVE_EPOCH",
                  "INCENTIVE_RESOLUTION_BYPASS"
                ]
              }
            },
            "pre_freeze_evidence_miss": {
              "type": "boolean"
            },
            "pre_freeze_evidence_note": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "retrospective_hypothesis_only": {
              "type": "boolean"
            }
          }
        },
        "pnl_status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "official_c_exposure",
            "official_c_model_pnl",
            "user_executed",
            "user_pnl",
            "c2_shadow_only"
          ],
          "properties": {
            "official_c_exposure": {
              "type": "boolean"
            },
            "official_c_model_pnl": {
              "type": [
                "number",
                "null"
              ]
            },
            "user_executed": {
              "type": "boolean"
            },
            "user_pnl": {
              "type": [
                "number",
                "null"
              ]
            },
            "c2_shadow_only": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
