{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "football-c4-semantic-v1",
  "title": "Football C4 Structured Evidence Board Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "matches"
  ],
  "properties": {
    "schema_version": {
      "const": "football-c4-semantic-v1"
    },
    "stage": {
      "const": "board"
    },
    "matches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/match"
      }
    }
  },
  "$defs": {
    "triAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "basis"
      ],
      "properties": {
        "state": {
          "enum": [
            "VERIFIED",
            "PARTIAL",
            "NONE"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "personnelAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "basis"
      ],
      "properties": {
        "state": {
          "enum": [
            "INTACT",
            "PARTIAL",
            "DAMAGED"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverageAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "basis"
      ],
      "properties": {
        "state": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "MISSING"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "drawAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "basis"
      ],
      "properties": {
        "state": {
          "enum": [
            "VERIFIED",
            "NOT_APPLICABLE",
            "NONE"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creation_repeatability",
        "dangerous_access",
        "service_finishing_continuity",
        "matched_opponent_leakage",
        "personnel_integrity",
        "route_suppression",
        "multi_goal_repeatability"
      ],
      "properties": {
        "creation_repeatability": {
          "$ref": "#/$defs/triAnchor"
        },
        "dangerous_access": {
          "$ref": "#/$defs/triAnchor"
        },
        "service_finishing_continuity": {
          "$ref": "#/$defs/triAnchor"
        },
        "matched_opponent_leakage": {
          "$ref": "#/$defs/triAnchor"
        },
        "personnel_integrity": {
          "$ref": "#/$defs/personnelAnchor"
        },
        "route_suppression": {
          "$ref": "#/$defs/triAnchor"
        },
        "multi_goal_repeatability": {
          "$ref": "#/$defs/triAnchor"
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_id",
        "common_evidence_basis",
        "home",
        "away",
        "mechanism_evidence_coverage",
        "team_news_coverage",
        "competition_context_coverage",
        "continuation_after_first_goal",
        "lead_control_tendency",
        "draw_utility",
        "mechanism_failure",
        "match_suppression",
        "upper_tail_repeatability"
      ],
      "properties": {
        "match_id": {
          "type": "string",
          "minLength": 1
        },
        "common_evidence_basis": {
          "type": "string",
          "minLength": 1
        },
        "home": {
          "$ref": "#/$defs/side"
        },
        "away": {
          "$ref": "#/$defs/side"
        },
        "mechanism_evidence_coverage": {
          "$ref": "#/$defs/coverageAnchor"
        },
        "team_news_coverage": {
          "$ref": "#/$defs/coverageAnchor"
        },
        "competition_context_coverage": {
          "$ref": "#/$defs/coverageAnchor"
        },
        "continuation_after_first_goal": {
          "$ref": "#/$defs/triAnchor"
        },
        "lead_control_tendency": {
          "$ref": "#/$defs/triAnchor"
        },
        "draw_utility": {
          "$ref": "#/$defs/drawAnchor"
        },
        "mechanism_failure": {
          "$ref": "#/$defs/triAnchor"
        },
        "match_suppression": {
          "$ref": "#/$defs/triAnchor"
        },
        "upper_tail_repeatability": {
          "$ref": "#/$defs/triAnchor"
        }
      }
    }
  }
}
