{
  "openapi": "3.1.0",
  "info": {"title": "SlipTrace ranked football board", "version": "1.0.0", "description": "Send an explicitly reviewed upcoming football shortlist to the owner's private workspace. This action freezes rankings; it does not place bets."},
  "servers": [{"url": "https://replace-with-your-worker.workers.dev"}],
  "security": [{"ownerKey": []}],
  "components": {
    "securitySchemes": {"ownerKey": {"type": "http", "scheme": "bearer"}},
    "schemas": {
      "Match": {"type": "object", "required": ["rank", "home", "away", "kickoff", "grade"], "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "home": {"type": "string"}, "away": {"type": "string"},
        "kickoff": {"type": "string", "format": "date-time", "description": "Upcoming ISO timestamp with explicit timezone, for example +07:00. Never guess the fixture date."},
        "grade": {"type": "string", "enum": ["A1", "A2", "B+", "B", "PASS"]},
        "competition": {"type": "string"}, "structuralType": {"type": "string"}, "evidence": {"type": "string", "maxLength": 15000}
      }},
      "Board": {"type": "object", "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "created_at": {"type": "string"}, "matches": {"type": "array", "items": {"type": "object", "additionalProperties": true}}}}
    }
  },
  "paths": {
    "/boards": {"post": {
      "operationId": "createRankedFootballBoard",
      "summary": "Freeze the user's reviewed ranked football shortlist",
      "x-openai-isConsequential": true,
      "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["title", "context", "matches"], "properties": {
        "title": {"type": "string", "maxLength": 120},
        "context": {"type": "string", "maxLength": 60000, "description": "The source analysis with primary routes, expected personnel, profiles, failure modes and evidence timestamps. Preserve uncertainty and missing data. Never fabricate context."},
        "matches": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/components/schemas/Match"}}
      }}}}},
      "responses": {"201": {"description": "Saved immutable board; the owner can refresh the website's board selector.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Board"}}}}, "400": {"description": "Invalid, duplicate or historical fixture."}, "401": {"description": "Owner key rejected."}}
    }},
    "/boards/{boardId}": {"get": {
      "operationId": "getRankedFootballBoard", "summary": "Read a previously saved board and assessment history",
      "parameters": [{"name": "boardId", "in": "path", "required": true, "schema": {"type": "string"}}],
      "responses": {"200": {"description": "Saved board", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Board"}}}}, "404": {"description": "Board not found."}}
    }}
  }
}
